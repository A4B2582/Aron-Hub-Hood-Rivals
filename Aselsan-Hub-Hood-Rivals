-- 3. MISC TAB (Anti-Kick & Anti-Ban)
-- ==========================================

MiscTab:Toggle({
    Title = "Anti-Kick Protection",
    Default = false,
    Callback = function(State)
        if State then
            pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local oldNamecall = mt.__namecall
                
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if method == "Kick" and self == LocalPlayer then
                        return
                    end
                    return oldNamecall(self, ...)
                end)
                setreadonly(mt, true)
            end)
        end
    end
})

MiscTab:Toggle({
    Title = "Advanced Anti-Ban",
    Default = false,
    Callback = function(State)
        if State then
            pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local oldNamecall = mt.__namecall
                
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if method == "FireServer" or method == "InvokeServer" then
                        local remoteName = tostring(self):lower()
                        if remoteName:find("ban") or remoteName:find("kick") or remoteName:find("cheat") or remoteName:find("detect") or remoteName:find("report") then
                            return
                        end
                    end
                    
                    if (method == "Kick" or method == "Ban") and self == LocalPlayer then
                        return
                    end
                    
                    return oldNamecall(self, ...)
                end)
                setreadonly(mt, true)
            end)
        end
    end
})
