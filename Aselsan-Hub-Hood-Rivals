-- Güvenli Takım Kontrolü
local function isTeammate(player)
    if player == LocalPlayer then return true end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return true
    end
    return false
end

-- Metin Girişlerini Güvenli Sayıya Çevirici
local function parseInput(Value, default)
    if type(Value) == "string" then
        return tonumber(Value) or default
    elseif type(Value) == "number" then
        return Value
    elseif type(Value) == "table" then
        return tonumber(Value.Value or Value.Text or Value[1]) or default
    end
    return default
end

-- Hood Rivals İçin Profesyonel Can Ayrıştırıcı
local function getCleanHealth(humanoid)
    if not humanoid then return 100, 100 end
    local currentHealth = humanoid.Health
    local maxHealth = humanoid.MaxHealth

    if maxHealth > 100 then
        maxHealth = 100
    end
    
    if currentHealth > maxHealth then
        currentHealth = maxHealth
    end

    return math.floor(math.clamp(currentHealth, 0, maxHealth)), math.floor(maxHealth)
end

