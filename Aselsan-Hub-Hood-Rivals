-- Combat Player ESP
local combatEspConnection = nil
local activeHighlights = {}
local activeBillboards = {}

CombatTab:Toggle({
    Title = "Player ESP",
    Default = false,
    Callback = function(State)
        if State then
            local function setupPlayer(player)
                if player == LocalPlayer then return end
                
                local function applyVisuals(character)
                    if not character then return end
                    
                    pcall(function()
                        local oldH = character:FindFirstChild("AselsanHighlight")
                        if oldH then oldH:Destroy() end
                        local oldB = character:FindFirstChild("AselsanInfo")
                        if oldB then oldB:Destroy() end

                        local teammate = isTeammate(player)
                        local boxColor = teammate and Color3.fromRGB(0, 120, 255) or Color3.fromRGB(255, 0, 0)

                        local highlight = Instance.new("Highlight")
                        highlight.Name = "AselsanHighlight"
                        highlight.Adornee = character
                        highlight.FillColor = boxColor
                        highlight.FillTransparency = 0.5
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.OutlineTransparency = 0
                        highlight.Parent = character
                        activeHighlights[player] = highlight

                        local head = character:WaitForChild("Head", 5)
                        if head then
                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = "AselsanInfo"
                            billboard.Adornee = head
                            billboard.Size = UDim2.new(0, 200, 0, 50)
                            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                            billboard.AlwaysOnTop = true

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.TextColor3 = boxColor
                            textLabel.TextStrokeTransparency = 0
                            textLabel.TextSize = 14
                            textLabel.Font = Enum.Font.SourceSansBold
                            textLabel.Parent = billboard

                            billboard.Parent = character
                            activeBillboards[player] = billboard

                            local connection
                            connection = RunService.RenderStepped:Connect(function()
                                if not character or not character.Parent or not player.Character then
                                    if connection then connection:Disconnect() end
                                    return
                                end

                                local humanoid = character:FindFirstChildOfClass("Humanoid")
                                local localChar = LocalPlayer.Character

                                if humanoid and localChar then
                                    local hrp = localChar:FindFirstChild("HumanoidRootPart")
                                    local charHrp = character:FindFirstChild("HumanoidRootPart")
                                    if hrp and charHrp then
                                        local distance = math.floor((hrp.Position - charHrp.Position).Magnitude)
                                        local health, maxHealth = getCleanHealth(humanoid)
                                        local tag = teammate and " [TEAM]" or " [ENEMY]"
                                        textLabel.Text = player.Name .. tag .. "\nHP: " .. health .. "/" .. maxHealth .. " | Dist: " .. distance .. "m"
                                    end
                                end
                            end)
                        end
                    end)
                end

                if player.Character then applyVisuals(player.Character) end
                player.CharacterAdded:Connect(applyVisuals)
            end

            for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
            combatEspConnection = Players.PlayerAdded:Connect(setupPlayer)
        else
            if combatEspConnection then
                combatEspConnection:Disconnect()
                combatEspConnection = nil
            end

            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character then
                    pcall(function()
                        local h = player.Character:FindFirstChild("AselsanHighlight") if h then h:Destroy() end
                        local b = player.Character:FindFirstChild("AselsanInfo") if b then b:Destroy() end
                    end)
                end
            end
            activeHighlights = {}
            activeBillboards = {}
        end
    end
})

